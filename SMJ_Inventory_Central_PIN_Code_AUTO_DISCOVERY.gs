// SMJ Inventory — Central PIN Authentication + Google Sheets Write Bridge
// Deploy as Web App: Execute as Me | Who has access: Anyone
// First-time setup is performed once from the website. All devices use the same PINs.

const AUTH_PREFIX = 'smj_auth_';
const TOKEN_PREFIX = 'smj_token_';
const FAIL_PREFIX = 'smj_fail_';
const TOKEN_TTL_MS = 14 * 24 * 60 * 60 * 1000;
const MAX_LOGIN_FAILURES = 5;
const LOCKOUT_MS = 10 * 60 * 1000;
const RECOVERY_HASH_KEY = 'smj_admin_recovery_hash';
const RECOVERY_SALT_KEY = 'smj_admin_recovery_salt';
const RECOVERY_FAIL_KEY = 'smj_admin_recovery_fail';

function doGet() {
  return out({ok:true, service:'SMJ Inventory Authentication', initialized:!!getPinRecord_('admin')});
}

function doPost(e) {
  try {
    const d = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    switch (String(d.action || '')) {
      case 'status': return out({ok:true, initialized:!!getPinRecord_('admin')});
      case 'setup': return setupAuth_(d);
      case 'login': return loginAuth_(d);
      case 'validate': return out({ok:true, role:verifyToken_(d.token)});
      case 'changePins': return changePins_(d);
      case 'recoverAdminPin': return recoverAdminPin_(d);
      case 'logout': return logoutAuth_(d);
      case 'listSheets': return listSheets_(d);
      case 'sync': return syncSheet_(d);
      default: throw new Error('Unknown request');
    }
  } catch (err) {
    return out({ok:false,error:String(err && err.message || err)});
  }
}

function setupAuth_(d) {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const p = PropertiesService.getScriptProperties();
    if (p.getProperty(AUTH_PREFIX + 'admin')) throw new Error('Already initialized. Please sign in.');
    const pins = d.pins || {};
    ['admin','partner','staff'].forEach(r => validatePin_(pins[r], r));
    ['admin','partner','staff'].forEach(r => storePin_(r, pins[r]));
    return out({ok:true,role:'admin',token:issueToken_('admin'),initialized:true});
  } finally { lock.releaseLock(); }
}

function loginAuth_(d) {
  const role = String(d.role || '').toLowerCase();
  const pin = String(d.pin == null ? '' : d.pin).trim();
  if (!['admin','partner','staff'].includes(role)) throw new Error('Invalid role');
  validatePin_(pin, role);
  const props = PropertiesService.getScriptProperties();
  const failKey = FAIL_PREFIX + role;
  const fail = JSON.parse(props.getProperty(failKey) || '{"count":0,"until":0}');
  if (Date.now() < Number(fail.until || 0)) throw new Error('Too many attempts. Try again in a few minutes.');
  const rec = getPinRecord_(role);
  if (!rec) throw new Error('This role has not been configured. Contact Admin.');
  if (!verifyPin_(pin, rec)) {
    const lock = LockService.getScriptLock();
    lock.waitLock(5000);
    try {
      const latest = JSON.parse(props.getProperty(failKey) || '{"count":0,"until":0}');
      const count = Number(latest.count || 0) + 1;
      props.setProperty(failKey, JSON.stringify({count:count,until:count >= MAX_LOGIN_FAILURES ? Date.now()+LOCKOUT_MS : 0}));
    } finally { lock.releaseLock(); }
    throw new Error('Incorrect PIN');
  }
  props.deleteProperty(failKey);
  return out({ok:true,role:role,token:issueToken_(role)});
}

function changePins_(d) {
  if (verifyToken_(d.token) !== 'admin') throw new Error('Only Admin can change PINs');
  const pins = d.pins || {};
  const roles = ['admin','partner','staff'].filter(r => pins[r] !== undefined && pins[r] !== null && String(pins[r]).trim() !== '');
  if (!roles.length) throw new Error('Enter at least one new PIN');
  roles.forEach(r => validatePin_(String(pins[r]).trim(), r));
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try { roles.forEach(r => storePin_(r, String(pins[r]).trim())); }
  finally { lock.releaseLock(); }
  return out({ok:true,message:'PINs updated'});
}

// One-time recovery. Recovery code is generated by running generateAdminRecoveryCode()
// manually in the Apps Script editor. The plaintext is logged once and never stored.
function generateAdminRecoveryCode() {
  if (!getPinRecord_('admin')) throw new Error('Initialize Admin PIN before creating a recovery code.');
  const code = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g,'').toUpperCase();
  const salt = Utilities.getUuid() + Utilities.getUuid();
  const props = PropertiesService.getScriptProperties();
  props.setProperty(RECOVERY_SALT_KEY, salt);
  props.setProperty(RECOVERY_HASH_KEY, sha_(salt + ':' + code));
  props.deleteProperty(RECOVERY_FAIL_KEY);
  Logger.log('SMJ ADMIN RECOVERY CODE (copy and store securely; shown only once): ' + code);
  return 'Recovery code generated. Copy it from the Execution log. It will not be shown again.';
}

function recoverAdminPin_(d) {
  const code = String(d.recoveryCode || '').replace(/\s+/g,'').toUpperCase();
  const newPin = String(d.newPin == null ? '' : d.newPin).trim();
  validatePin_(newPin, 'admin');
  if (!code || code.length < 32) throw new Error('Invalid recovery code');
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const props = PropertiesService.getScriptProperties();
    const fail = JSON.parse(props.getProperty(RECOVERY_FAIL_KEY) || '{"count":0,"until":0}');
    if (Date.now() < Number(fail.until || 0)) throw new Error('Recovery temporarily locked. Try again later.');
    const salt = props.getProperty(RECOVERY_SALT_KEY);
    const expected = props.getProperty(RECOVERY_HASH_KEY);
    if (!salt || !expected || sha_(salt + ':' + code) !== expected) {
      const count = Number(fail.count || 0) + 1;
      props.setProperty(RECOVERY_FAIL_KEY, JSON.stringify({count:count,until:count >= 5 ? Date.now()+30*60*1000 : 0}));
      throw new Error('Incorrect recovery code');
    }
    storePin_('admin', newPin);
    // Consume recovery code after one successful use.
    props.deleteProperty(RECOVERY_HASH_KEY);
    props.deleteProperty(RECOVERY_SALT_KEY);
    props.deleteProperty(RECOVERY_FAIL_KEY);
    // Revoke every existing session so old Admin/Partner/Staff sessions cannot survive recovery.
    const all = props.getProperties();
    Object.keys(all).forEach(k => { if (k.indexOf(TOKEN_PREFIX) === 0) props.deleteProperty(k); });
    props.deleteProperty(FAIL_PREFIX + 'admin');
    return out({ok:true,message:'Admin PIN reset. Sign in with the new PIN.'});
  } finally { lock.releaseLock(); }
}

function logoutAuth_(d) {
  if (d.token) PropertiesService.getScriptProperties().deleteProperty(TOKEN_PREFIX + sha_(String(d.token)));
  return out({ok:true});
}

function validatePin_(pin, role) {
  if (!/^[0-9]{4,12}$/.test(String(pin == null ? '' : pin).trim())) throw new Error(role + ' PIN must be 4–12 digits');
}
function storePin_(role, pin) {
  const salt = Utilities.getUuid() + Utilities.getUuid();
  PropertiesService.getScriptProperties().setProperty(AUTH_PREFIX + role, JSON.stringify({salt:salt,hash:pinHash_(String(pin),salt)}));
}
function getPinRecord_(role) {
  const v = PropertiesService.getScriptProperties().getProperty(AUTH_PREFIX + role);
  return v ? JSON.parse(v) : null;
}
function pinHash_(pin,salt) {
  let v = salt + ':' + pin;
  for (let i=0;i<12000;i++) v = Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v));
  return v;
}
function verifyPin_(pin,rec) { return !!(rec && rec.salt && rec.hash && pinHash_(String(pin),rec.salt) === rec.hash); }
function sha_(s) { return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s)); }
function issueToken_(role) {
  const token = Utilities.getUuid() + Utilities.getUuid();
  PropertiesService.getScriptProperties().setProperty(TOKEN_PREFIX + sha_(token), JSON.stringify({role:role,expires:Date.now()+TOKEN_TTL_MS}));
  return token;
}
function verifyToken_(token) {
  if (!token) throw new Error('Please sign in again');
  const props = PropertiesService.getScriptProperties(), key = TOKEN_PREFIX + sha_(String(token));
  const raw = props.getProperty(key);
  if (!raw) throw new Error('Session expired. Sign in again');
  const session = JSON.parse(raw);
  if (Date.now() > Number(session.expires || 0)) { props.deleteProperty(key); throw new Error('Session expired. Sign in again'); }
  if (!['admin','partner','staff'].includes(session.role)) throw new Error('Invalid session');
  return session.role;
}

function listSheets_(d) {
  verifyToken_(d.token);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const result = [];
  ss.getSheets().forEach(sh => {
    const lastRow = Math.min(sh.getLastRow(), 12);
    const lastCol = sh.getLastColumn();
    if (!lastRow || !lastCol) return;
    const grid = sh.getRange(1, 1, lastRow, lastCol).getDisplayValues();
    let headerRow = -1;
    for (let r = 0; r < grid.length; r++) {
      const first = String(grid[r][0] || '').trim().toLowerCase();
      const headers = grid[r].map(v => String(v || '').trim().toLowerCase());
      if (first === 'item no.' &&
          headers.includes('item code') &&
          headers.includes('sales quantity') &&
          headers.includes('received quantity') &&
          headers.includes('stock in hand')) {
        headerRow = r + 1;
        break;
      }
    }
    if (headerRow > 0) result.push({name: sh.getName(), headerRow: headerRow});
  });
  return out({ok:true, sheets:result});
}

function syncSheet_(d) {
  const role = verifyToken_(d.token);
  if (!['admin','partner'].includes(role)) throw new Error('Your role cannot write to the inventory sheet');
  const sheetName = String(d.sheet || '').trim();
  if (!sheetName || !Array.isArray(d.items) || !d.items.length || d.items.length > 100) throw new Error('Invalid sheet or item list');
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(sheetName);
  if (!sh) return out({ok:false,error:'Sheet not found: ' + sheetName,results:[]});
  const props = PropertiesService.getScriptProperties();
  const values = sh.getDataRange().getValues();
  let hRow = -1;
  for (let i=0;i<values.length;i++) if (String(values[i][0]).trim()==='Item No.') { hRow=i; break; }
  if (hRow<0) return out({ok:false,error:'Header row (Item No.) not found',results:[]});
  const headers = values[hRow].map(x=>String(x).trim());
  const col = name => headers.indexOf(name);
  const cCode=col('Item Code'), cSales=col('Sales Quantity'), cRecv=col('Received Quantity'), cStock=col('Stock in Hand');
  if ([cCode,cSales,cRecv,cStock].some(i=>i<0)) throw new Error('Required inventory columns are missing');
  const results=[];
  d.items.forEach(it => {
    const id = String(it && it.id || '').trim();
    const code = String(it && it.code || '').trim();
    if (!/^[a-zA-Z0-9_-]{5,80}$/.test(id) || !code) { results.push({id:id,status:'error',error:'Invalid operation ID or item code'}); return; }
    const key='op_'+id;
    if (props.getProperty(key)) { results.push({id:id,status:'skipped'}); return; }
    let row=-1;
    for (let r=hRow+1;r<values.length;r++) if (String(values[r][cCode]).trim()===code) { row=r; break; }
    if (row<0) { results.push({id:id,status:'notfound'}); return; }
    const rowNum=row+1;
    try {
      if (it.type==='rate') {
        if (role!=='admin') throw new Error('Only Admin can edit rates');
        const field=String(it.field || '').trim();
        const protectedCols=['Item No.','Item Code','Sales Quantity','Received Quantity','Stock in Hand'];
        if (!field || protectedCols.includes(field)) throw new Error('This column cannot be edited');
        let ci=headers.indexOf(field);
        if (ci<0) { ci=headers.length; headers.push(field); sh.getRange(hRow+1,ci+1).setValue(field); }
        const raw=String(it.value == null ? '' : it.value).trim();
        if (!raw || !isFinite(Number(raw))) throw new Error('Rate must be numeric');
        sh.getRange(rowNum,ci+1).setValue(Number(raw));
      } else if (it.type==='sale') {
        if (role!=='admin' && role!=='partner') throw new Error('Not allowed');
        const qty=Number(it.qty);
        if (!Number.isInteger(qty) || qty<=0 || qty>100000) throw new Error('Invalid sale quantity');
        const currentSales=Number(values[row][cSales]) || 0;
        const received=Number(values[row][cRecv]) || 0;
        const sales=currentSales+qty;
        sh.getRange(rowNum,cSales+1).setValue(sales);
        sh.getRange(rowNum,cStock+1).setValue(received-sales);
      } else throw new Error('Unknown operation type');
      props.setProperty(key,'1');
      results.push({id:id,status:'done'});
    } catch(err) { results.push({id:id,status:'error',error:String(err && err.message || err)}); }
  });
  SpreadsheetApp.flush();
  return out({ok:true,results:results});
}

function out(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}